# AuditAI Busan — AI 상담 보조 설정
# 사용법: 이 파일을 .env 로 복사한 뒤 키만 채우세요.
#   copy .env.example .env
# 실제 키는 Git/공유 폴더에 올리지 마세요.

# --- 필수 ---
# OpenAI 호환 API 키 (OpenAI / Azure OpenAI / 호환 게이트웨이)
OPENAI_API_KEY=sk-여기에_본인_키_입력

# --- 권장 ---
# true 이면 /api/counsel 사용, false 이면 규칙엔진만 동작
AI_ENABLED=true

# OpenAI 호환 엔드포인트 (끝의 /v1 까지)
OPENAI_BASE_URL=https://api.openai.com/v1

# 모델 (저온·짧은 출력 권장 — 할루시네이션 억제)
OPENAI_MODEL=gpt-4o-mini

# 생성 파라미터 (상담 해설은 온도 0 권장)
AI_TEMPERATURE=0
AI_MAX_TOKENS=900

# 메일 다듬기 전용 온도 (0이면 문장이 거의 안 바뀜 → 0.4~0.5 권장)
AI_MAIL_TEMPERATURE=0.45

# 로컬 서버 포트 (시작하기.bat 과 동일)
PORT=8765

# 브라우저→서버 허용 Origin (비우면 localhost만)
# ALLOWED_ORIGIN=http://127.0.0.1:8765
